<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Include Spring Boot's default logging configuration -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="api-gateway"/>

    <!-- ═══ Console Appender ════════════════════════════════════════════════ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!--
                Pattern includes:
                  %d{...}        - Timestamp
                  [%thread]      - Thread name (Netty event loop)
                  %-5level       - Log level padded to 5 chars
                  [%X{correlationId}] - MDC correlation ID (set by CorrelationIdFilter)
                  %logger{36}    - Logger name truncated to 36 chars
                  - %msg%n       - Log message + newline
            -->
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{correlationId}] %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ═══ JSON File Appender (for production log aggregation) ════════════ -->
    <springProfile name="prod">
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/var/log/api-gateway/api-gateway.log</file>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${APP_NAME}"}</customFields>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>/var/log/api-gateway/api-gateway.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
                <timeBasedFileNamingAndTriggeringPolicy
                        class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                    <maxFileSize>100MB</maxFileSize>
                </timeBasedFileNamingAndTriggeringPolicy>
                <maxHistory>30</maxHistory>
                <totalSizeCap>3GB</totalSizeCap>
            </rollingPolicy>
        </appender>
    </springProfile>

    <!-- ═══ Root Logger ════════════════════════════════════════════════════ -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Gateway-specific logger -->
    <logger name="com.mobisec.in.apigateway" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Reduce noise from Netty / Reactor internals -->
    <logger name="reactor.netty" level="WARN"/>
    <logger name="io.netty" level="WARN"/>

</configuration>
